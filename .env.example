# Public URL of the live site (used for canonical URLs, Open Graph, sitemap).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Webhook that receives contact-form submissions as JSON
# (e.g. Formspree, Make, Zapier, or n8n set up to email the team).
# Until this is set, the form tells visitors online requests aren't available yet.
CONTACT_WEBHOOK_URL=
